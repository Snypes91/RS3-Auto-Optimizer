# Save as: RS3-Auto-Setup-Optimize.ps1
# --------------------------------------------------------------
# RS3 AUTO-SETUP + OPTIMIZER v5.0 - ULTRA ROBUST (2025)
# Full error handling, logging, retries, recovery
# --------------------------------------------------------------

$ErrorActionPreference = "Continue"
$LogFile = "C:\RS3-Optimizer.log"
$MaxRetries = 3
$RetryDelay = 5
$InstallTimeout = 180
$PostInstallWait = 60

function Log {
    param([string]$Message, [string]$Level="INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    "$timestamp [$Level] $Message" | Out-File -FilePath $LogFile -Append -Encoding UTF8
    Write-Host "[$Level] $Message" -ForegroundColor $(if($Level -eq "ERROR"){ "Red" } elseif($Level -eq "WARN"){ "Yellow" } else { "White" })
}

Log "=== RS3 AUTO-SETUP & OPTIMIZER v5.0 STARTED ===" "INFO"

if (-not ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Log "ERROR: Run as Administrator!" "ERROR"
    Read-Host "Press Enter to exit"; exit 1
}

$possiblePaths = @(
    "$env:LOCALAPPDATA\RuneScape\RuneScape.exe",
    "$env:USERPROFILE\jagex_launcher\RuneScape.exe",
    "${env:ProgramFiles(x86)}\Jagex Launcher\Games\RuneScape\RuneScape.exe",
    "${env:ProgramFiles}\Jagex Launcher\Games\RuneScape\RuneScape.exe",
    "$env:LOCALAPPDATA\jagex_launcher\bin\RuneScape.exe"
)

$rsExe = $null
foreach ($path in $possiblePaths) {
    if (Test-Path $path -ErrorAction SilentlyContinue) { $rsExe = $path; Log "Found: $rsExe" "INFO"; break }
}

if (-not $rsExe) {
    Log "Installing RS3..." "INFO"
    $dlUrl = "https://content.runescape.com/downloads/windows/RuneScape-Setup.exe"
    $installer = "$env:TEMP\RuneScape-Setup.exe"

    $downloaded = $false
    for ($i = 1; $i -le $MaxRetries; $i++) {
        try {
            Remove-Item $installer -Force -ErrorAction SilentlyContinue
            Invoke-WebRequest -Uri $dlUrl -OutFile $installer -UseBasicParsing -TimeoutSec 300 -ErrorAction Stop
            if ((Get-Item $installer).Length -gt 50MB) { $downloaded = $true; Log "Downloaded" "INFO"; break }
        } catch { Log "Download retry $i failed: $($_.Exception.Message)" "ERROR"; Start-Sleep $RetryDelay }
    }

    if (-not $downloaded) {
        Log "Download failed. Opening browser..." "ERROR"
        Start-Process "https://www.runescape.com/download"; Read-Host "Install manually → Enter"; & $MyInvocation.MyCommand.Path; exit
    }

    try {
        $proc = Start-Process -FilePath $installer -ArgumentList "/S" -PassThru -WindowStyle Hidden -ErrorAction Stop
        $waited = 0
        while (-not $proc.HasExited -and $waited -lt $InstallTimeout) { Start-Sleep 1; $waited++ }
        if (-not $proc.HasExited) { $proc.Kill(); throw "Timeout" }
        Log "Install complete" "INFO"
    } catch { Log "Install failed: $($_.Exception.Message)" "ERROR"; Read-Host "Try manual → Enter"; & $MyInvocation.MyCommand.Path; exit } finally { Remove-Item $installer -Force -ErrorAction SilentlyContinue }

    for ($w = 0; $w -lt $PostInstallWait; $w += 3) {
        Start-Sleep 3
        foreach ($path in $possiblePaths) {
            if (Test-Path $path) { $rsExe = $path; Log "Found post-install: $rsExe" "INFO"; break }
        }
        if ($rsExe) { break }
    }

    if (-not $rsExe) {
        $reboot = Read-Host "Reboot? (y/n)"
        if ($reboot -match '^[Yy]') { Restart-Computer -Force } else { Start-Process "steam://install/1343400"; Read-Host "Steam install → Enter"; exit }
    }
}

Log "Optimizing system..." "INFO"
$opt = @(
    { powercfg -setactive e9a42b02-d5df-448d-aa00-03f14749eb61 },
    { reg add "HKCU\System\GameConfigStore" /v "GameDVR_FSEBehaviorMode" /t REG_DWORD /d 2 /f },
    { reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\GameDVR" /v "AppCaptureEnabled" /t REG_DWORD /d 0 /f },
    { netsh int tcp set global autotuninglevel=normal },
    { reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile" /v "NetworkThrottlingIndex" /t REG_DWORD /d 0xffffffff /f },
    { reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" /v "VisualFXSetting" /t REG_DWORD /d 2 /f }
)
foreach ($cmd in $opt) { try { & $cmd *>$null } catch { Log "Opt failed: $($_.Exception.Message)" "WARN" } }

@('chrome','msedge','discord','steam','RuneScape','JagexLauncher') | ForEach-Object { Get-Process -Name $_ -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue }

Log "Launching RS3..." "INFO"
try {
    $p = Start-Process -FilePath $rsExe -PassThru -ErrorAction Stop
    Start-Sleep 3
    if ($p -and -not $p.HasExited) { $p.PriorityClass = "High"; Log "LAUNCHED PID $($p.Id)" "INFO" }
} catch { Log "Launch failed: $($_.Exception.Message)" "ERROR" }

Log "DONE! Log: $LogFile" "INFO"
Write-Host "`nRS3 Running! Log: $LogFile" -ForegroundColor Green
Read-Host "Press Enter to exit"
